generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invoice {
  id                  String   @id
  externalId          String   @unique
  status              String
  amount              Int
  payerEmail          String
  description         String
  invoiceUrl          String?
  paidAt              DateTime?
  createdAt           DateTime @default(now())
}
